{
  "tasks": [
    {
      "task_id": "laew-manifest-check",
      "description": "Read the LAEW system manifest and report what workspace root is configured",
      "input_prompt": "Read manifests/SYSTEM_MANIFEST.yaml and tell me what workspace root is configured.",
      "expected_tool_calls": [
        {
          "tool": "FilesystemTool",
          "operation": "view_file",
          "args": {
            "file_path": "manifests/SYSTEM_MANIFEST.yaml"
          }
        }
      ],
      "expected_outcome_contains": [
        "workspace"
      ],
      "expected_outcome_not_contains": [
        "error",
        "failed"
      ],
      "evaluation_criteria": {
        "relevance_threshold": 0.8
      },
      "metadata": {
        "category": "manifest",
        "difficulty": "easy"
      }
    },
    {
      "task_id": "laew-filesystem-list",
      "description": "List files in the LAEW project root",
      "input_prompt": "List all files and directories in the current workspace root.",
      "expected_tool_calls": [
        {
          "tool": "FilesystemTool",
          "operation": "list_dir",
          "args": {
            "directory_path": "."
          }
        }
      ],
      "expected_outcome_contains": [
        "laew",
        "tests",
        "docs",
        "manifests"
      ],
      "expected_outcome_not_contains": [
        "error",
        "failed"
      ],
      "evaluation_criteria": {
        "relevance_threshold": 0.8
      },
      "metadata": {
        "category": "filesystem",
        "difficulty": "easy"
      }
    },
    {
      "task_id": "laew-git-status",
      "description": "Check git status of the LAEW repository",
      "input_prompt": "What is the current git status of the repository? Are there any uncommitted changes?",
      "expected_tool_calls": [
        {
          "tool": "GitTool",
          "operation": "git_status",
          "args": {}
        }
      ],
      "expected_outcome_contains": [
        "branch"
      ],
      "expected_outcome_not_contains": [
        "error",
        "failed"
      ],
      "evaluation_criteria": {
        "relevance_threshold": 0.8
      },
      "metadata": {
        "category": "git",
        "difficulty": "easy"
      }
    },
    {
      "task_id": "laew-tool-filesystem-view-readme",
      "description": "View the README.md file using the filesystem tool",
      "input_prompt": "Please read the README.md file and summarize what LAEW is about.",
      "expected_tool_calls": [
        {
          "tool": "FilesystemTool",
          "operation": "view_file",
          "args": {
            "file_path": "README.md"
          }
        }
      ],
      "expected_outcome_contains": [
        "LAEW",
        "Local AI Engineering Workspace"
      ],
      "expected_outcome_not_contains": [
        "error",
        "failed"
      ],
      "evaluation_criteria": {
        "relevance_threshold": 0.8
      },
      "metadata": {
        "category": "filesystem",
        "difficulty": "medium"
      }
    },
    {
      "task_id": "laew-manifest-model-roles",
      "description": "Read the system manifest and report what model roles are defined",
      "input_prompt": "Read manifests/SYSTEM_MANIFEST.yaml and tell me what model roles are defined for LAEW.",
      "expected_tool_calls": [
        {
          "tool": "FilesystemTool",
          "operation": "view_file",
          "args": {
            "file_path": "manifests/SYSTEM_MANIFEST.yaml"
          }
        }
      ],
      "expected_outcome_contains": [
        "role"
      ],
      "expected_outcome_not_contains": [
        "error",
        "failed"
      ],
      "evaluation_criteria": {
        "relevance_threshold": 0.8
      },
      "metadata": {
        "category": "manifest",
        "difficulty": "medium"
      }
    }
  ]
}
