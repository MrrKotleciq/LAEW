    {
      "id": "h01",
      "text": "Why initialize communication before enabling the actuator, including warm restarts?",
      "language": "en",
      "phenomenon": "description_code",
      "split": "dev",
      "allowed_scope": "global",
      "expected_document_ids": [
        "@knowledge/startup.md"
      ],
      "relevance": {
        "@knowledge/startup.md": 2
      },
      "no_answer": null,
      "evidence": [
        {
          "document_id": "@knowledge/startup.md",
          "passage": "Communication must be initialized before the actuator to reject stale commands."
        },
        {
          "document_id": "@knowledge/startup.md",
          "passage": "initialize_communication()"
        },
        {
          "document_id": "@knowledge/startup.md",
          "passage": "This order is mandatory even after a warm restart."
        }
      ]
    },
    {
