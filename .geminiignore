# ============================================================
# LAEW — Gemini Ignore
# ============================================================
# Exclude generated, cached, binary and environment-specific
# data that should not be included in Gemini's project context.
#
# IMPORTANT:
# Do NOT ignore source code, documentation, manifests,
# tool contracts, prompts, tests or project configuration.
# ============================================================


# ------------------------------------------------------------
# Git internals
# ------------------------------------------------------------

.git/
.git/**


# ------------------------------------------------------------
# Python — virtual environments and caches
# ------------------------------------------------------------

.venv/
venv/
env/
ENV/

__pycache__/
**/__pycache__/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

*.py[cod]
*$py.class


# ------------------------------------------------------------
# Node.js / JavaScript generated data
# ------------------------------------------------------------

node_modules/
**/node_modules/

.npm/
.yarn/
.pnpm-store/

dist/
build/
coverage/

*.tsbuildinfo


# ------------------------------------------------------------
# Build / generated artifacts
# ------------------------------------------------------------

**/build/
**/dist/
**/out/
**/target/

*.o
*.obj
*.so
*.dll
*.dylib
*.a
*.lib
*.exe


# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log
**/*.log

logs/
**/logs/


# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------

tmp/
temp/
.tmp/
.cache/

**/tmp/
**/temp/
**/.tmp/
**/.cache/

*.tmp
*.temp
*.bak
*.swp
*.swo
*~


# ------------------------------------------------------------
# OS / editor metadata
# ------------------------------------------------------------

.DS_Store
Thumbs.db

.idea/
.vscode/

# Keep project-specific editor configuration visible only if
# it is intentionally part of the repository.
# If LAEW later commits .vscode settings, remove the .vscode/
# rule above.


# ------------------------------------------------------------
# Large binary / model files
# ------------------------------------------------------------

*.bin
*.gguf
*.ggml
*.safetensors
*.pt
*.pth
*.onnx
*.ckpt
*.h5
*.tflite

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar


# ------------------------------------------------------------
# Media / generated assets
# ------------------------------------------------------------

*.mp3
*.wav
*.flac
*.ogg
*.mp4
*.mkv
*.avi
*.mov

*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico


# ------------------------------------------------------------
# Databases / runtime state
# ------------------------------------------------------------

*.sqlite
*.sqlite3
*.db

*.pid
*.sock


# ------------------------------------------------------------
# Secrets / credentials
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

credentials.json
service-account*.json

# Common secret/config directories
secrets/
credentials/


# ------------------------------------------------------------
# Terraform / infrastructure generated state
# ------------------------------------------------------------

.terraform/
.terraform.lock.hcl

*.tfstate
*.tfstate.*


# ------------------------------------------------------------
# Docker generated/runtime data
# ------------------------------------------------------------

docker-data/
docker-volumes/

# Do NOT ignore Dockerfiles or docker-compose files.


# ------------------------------------------------------------
# Package manager caches
# ------------------------------------------------------------

.pip-cache/
pip-wheel-metadata/

.poetry/
.pyright/


# ------------------------------------------------------------
# Local AI / model caches
# ------------------------------------------------------------

models/
model-cache/
model_cache/

huggingface/
.cache/huggingface/

ollama/
ollama-data/

# Do not ignore model configuration or manifests.
# Only actual model/cache data should be excluded.


# ------------------------------------------------------------
# Generated documentation / reports
# ------------------------------------------------------------

*.pdf
*.html

# NOTE:
# Markdown documentation remains visible.
# Do not ignore *.md.


# ------------------------------------------------------------
# Test-generated data
# ------------------------------------------------------------

test-results/
test-results/
playwright-report/
.nyc_output/


# ------------------------------------------------------------
# Local runtime state
# ------------------------------------------------------------

runtime/
run/
state/

*.pid
*.lock


# ============================================================
# END
# ============================================================