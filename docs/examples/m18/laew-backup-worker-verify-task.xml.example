<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>&lt;APPROVED_WINDOW_START&gt;</StartBoundary>
      <Enabled>false</Enabled>
      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Operator">
      <UserId>&lt;APPROVED_OPERATOR_IDENTITY&gt;</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <Enabled>false</Enabled>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>false</StartWhenAvailable>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Operator">
    <Exec>
      <Command>&lt;ABSOLUTE_TRUSTED_WORKER_PYTHON&gt;</Command>
      <Arguments>-I -m laew.backup_worker backup verify --id &lt;APPROVED_GENERATION_UUID&gt; --profile &quot;&lt;ABSOLUTE_PROFILE&gt;&quot; --status-file &quot;&lt;ABSOLUTE_STATUS_FILE&gt;&quot; --json</Arguments>
      <WorkingDirectory>&lt;PROTECTED_WORKING_DIRECTORY&gt;</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
